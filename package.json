{
  "name": "freeeats-campus-free-food",
  "version": "1.0.0",
  "description": "Find and share free food on campus. Post a photo, servings and location; students browse nearby food and check in for a serving. No dependencies.",
  "main": "src/server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:mail": "node --env-file=.env src/server.js",
    "dev": "node --watch src/server.js",
    "dev:mail": "node --env-file=.env --watch src/server.js",
    "test": "node --test test/",
    "demo": "node scripts/demo.js",
    "fake-checkin": "node scripts/fake-checkin.js"
  }
}
